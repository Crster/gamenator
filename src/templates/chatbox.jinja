<html>

<head>
  <title>Gamenator</title>
  <link href="{{ url_for('static', path='/styles.css') }}" rel="stylesheet">
  <script src="{{ url_for('static', path='/app/chatbox.js') }}"></script>
</head>

<body>
  <main class="container">
    <iframe class="preview" src="{{ url_for('preview', gameid=gameid) }}">
    </iframe>

    <form class="prompt" onsubmit="handleOnSubmit(event)">
      <input type="text" name="prompt" placeholder="Describe your game?">
      <button type="submit">Submit</button>
    </form>
  </main>
</body>

</html>